<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=Edge">
<meta charset="utf-8">
<title>DoingLio · Iniciando</title>
<HTA:APPLICATION ID="DoingLioInicio" APPLICATIONNAME="DoingLio Inicio" ICON="C:\Sistemas\DoingLioLauncher\brain-davinci.ico" BORDER="none" CAPTION="no" SHOWINTASKBAR="no" SCROLL="no" SYSMENU="no" WINDOWSTATE="maximize">
<style>
*{box-sizing:border-box}
html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden;color:#f7eddc;background:#090908;font-family:Segoe UI,Arial,sans-serif}
.main{width:100%;height:100%;position:relative;text-align:center;border:0;border-radius:0;background:radial-gradient(circle at 50% 45%,#2a1b0f 0,#090908 58%,#070707 100%);overflow:hidden}
.clock-bg{position:absolute;left:0;top:0;width:100%;height:100%;z-index:0;overflow:hidden}
.doomsday-clock-bg{position:absolute;left:50%;top:50%;width:310px;height:310px;opacity:.6;filter:drop-shadow(0 0 24px #dc862344);-ms-transform:translate(-50%,-50%)}
.doom-spiral{fill:none;stroke:url(#spiralGlow);stroke-width:2.1;stroke-linecap:round}
.doom-orbit{fill:none;stroke:#d7ad5d24;stroke-width:1}
.doom-orbit.dash{stroke-dasharray:3 9}
.doom-tick{stroke:#d7ad5d5e;stroke-width:1.4}
.doom-tick.major{stroke:#f0c36e9e;stroke-width:2.1}
.doom-hand{stroke:#f2d09a;stroke-linecap:round}
.doom-hand.hour{stroke-width:7}
.doom-hand.minute{stroke-width:5}
.doom-center-ring{fill:#0b0907;stroke:#f3b35a;stroke-width:2.5}
.doom-center{fill:#ffd083}
.doom-trail-point{fill:#df8b2e;opacity:.9}
.text{position:absolute;left:0;right:0;bottom:31px;z-index:2;text-align:center}
.brain-logo{display:block;width:72px;height:72px;margin:0 auto 5px;filter:drop-shadow(0 0 14px #df8b2e66)}
.title{font-family:Georgia,serif;font-size:27px;letter-spacing:1.2px;color:#f2d6af}
.sub{font-size:12px;color:#dba971;margin-top:7px;letter-spacing:1.1px}
.spin{font-size:11px;color:#ad9d8d;margin-top:10px;letter-spacing:1px}
.build{position:absolute;left:78px;top:19px;z-index:6;min-width:128px;padding:11px 16px;border:1px solid #d89f61;border-radius:12px;background:#241910ee;box-shadow:0 0 26px #d9823b27;font:bold 16px/1.4 Segoe UI,Arial,sans-serif;letter-spacing:2px;color:#ffdb9f;text-align:left}
.close-app{position:absolute;left:14px;top:14px;z-index:5;width:48px;height:48px;border-radius:12px;border:1px solid #bb8e57;background:#20160f;color:#ffe0ae;font:normal 30px/1 Segoe UI,Arial,sans-serif;cursor:pointer}
.close-app:hover,.close-app:focus{background:#a45932;color:#fff}
.theme-switch{position:absolute;right:18px;top:19px;z-index:7;padding:10px 14px;border:1px solid #bd8e55;border-radius:10px;background:#22180f;color:#f5dbb7;font:600 13px Segoe UI,Arial;cursor:pointer}
html.light,html.light body{background:#f4ebde;color:#362617}
html.light .main{background:radial-gradient(circle at 50% 45%,#fff8eb 0,#eaddc7 80%,#ddcfb8 100%)}
html.light .title{color:#4b2e19}html.light .sub{color:#855c35}html.light .spin{color:#665443}
html.light .build,html.light .close-app,html.light .theme-switch{background:#fffaee;color:#52351c;border-color:#ac865d}
html.light .doom-orbit{stroke:#8e663e55}html.light .doomsday-clock-bg{filter:drop-shadow(0 0 20px #a2682450)}
</style>
<script type="text/javascript">
var started=new Date().getTime();
var versionPath='C:\\Sistemas\\DoingLioLauncher\\last_build.txt';
var themePath='C:\\Sistemas\\DoingLioLauncher\\theme.txt';
function themeFile(){return new ActiveXObject('Scripting.FileSystemObject');}
function applyTheme(value,save){
 var theme=value==='light'?'light':'dark';
 document.documentElement.className=theme==='light'?'light':'';
 document.getElementById('theme-switch').innerText=theme==='light'?'Activar oscuro':'Activar claro';
 if(save){try{var f=themeFile().CreateTextFile(themePath,true);f.Write(theme);f.Close();}catch(e){}}
}
function loadTheme(){
 try{var fs=themeFile();if(fs.FileExists(themePath)){var f=fs.OpenTextFile(themePath,1,false);var v=f.ReadAll().replace(/\s/g,'');f.Close();applyTheme(v,false);return;}}catch(e){}
 applyTheme('dark',false);
}
function toggleTheme(){applyTheme(document.documentElement.className==='light'?'dark':'light',true);}
function refreshBuild(){
 try{
   var fs=new ActiveXObject('Scripting.FileSystemObject');
   if(!fs.FileExists(versionPath)) return;
   var f=fs.OpenTextFile(versionPath,1,false);
   var v=f.ReadAll().replace(/\s/g,'');f.Close();
   if(/^\d+$/.test(v))document.getElementById('startup-build').innerText='D\u00b7'+v;
 }catch(e){}
}
function cancelStartup(){
 try{
   var fs=new ActiveXObject('Scripting.FileSystemObject');
   var f=fs.CreateTextFile('C:\\Sistemas\\DoingLioLauncher\\cancel.flag',true);
   f.WriteLine('cancelado');f.Close();
 }catch(e){}
 window.close();
}
function fullscreenWindow(){
  try {
    window.moveTo(0,0);
    window.resizeTo(screen.width,screen.height);
  } catch(e){}
}
function animate(){
 try{
   var progress=((new Date().getTime()-started)%9800)/9800;
   var scale=.06+5.2*Math.pow(progress,1.6);
   var opacity=progress<.08?progress/.08*.56:(progress>.85?(1-progress)/.15*.56:.56);
   var clock=document.getElementById('clock');
   clock.style.msTransform='translate(-50%,-50%) scale('+scale+')';
   clock.style.transform='translate(-50%,-50%) scale('+scale+')';
   clock.style.opacity=opacity;
   var dots=['.','..','...'][Math.floor((new Date().getTime()-started)/650)%3];
   document.getElementById('dots').innerText='ACTUALIZANDO PROYECTOS'+dots;
 }catch(e){}
}
window.onload=function(){fullscreenWindow();loadTheme();refreshBuild();animate();window.setInterval(animate,50);window.setInterval(refreshBuild,850)}
</script>
</head>
<body>
<div class="main">
 <button type="button" class="close-app" title="Cancelar inicio y cerrar" aria-label="Cancelar inicio y cerrar" onclick="cancelStartup()">&#215;</button>
 <button type="button" class="theme-switch" id="theme-switch" onclick="toggleTheme()">Activar claro</button>
 <div class="build" id="startup-build" title="Versión de DoingLio" role="status" aria-live="polite">D&#183;...</div>
 <div class="clock-bg" aria-hidden="true">
      <svg id="clock" class="doomsday-clock-bg" viewBox="0 0 500 500">
      <defs>
        <linearGradient id="spiralGlow" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffd083" stop-opacity=".96"/>
          <stop offset=".48" stop-color="#dc8623" stop-opacity=".80"/>
          <stop offset="1" stop-color="#cba45d" stop-opacity=".16"/>
        </linearGradient>
      </defs>
      <circle class="doom-orbit" cx="250" cy="250" r="182"/>
      <circle class="doom-orbit dash" cx="250" cy="250" r="154"/>
      <circle class="doom-orbit" cx="250" cy="250" r="112" opacity=".55"/>
      <g>
        <line class="doom-tick major" x1="250" y1="56" x2="250" y2="72"/>
        <line class="doom-tick" x1="347" y1="82" x2="339" y2="96"/>
        <line class="doom-tick major" x1="418" y1="153" x2="404" y2="161"/>
        <line class="doom-tick" x1="444" y1="250" x2="428" y2="250"/>
        <line class="doom-tick major" x1="418" y1="347" x2="404" y2="339"/>
        <line class="doom-tick" x1="347" y1="418" x2="339" y2="404"/>
        <line class="doom-tick major" x1="250" y1="444" x2="250" y2="428"/>
        <line class="doom-tick" x1="153" y1="418" x2="161" y2="404"/>
        <line class="doom-tick major" x1="82" y1="347" x2="96" y2="339"/>
        <line class="doom-tick" x1="56" y1="250" x2="72" y2="250"/>
        <line class="doom-tick major" x1="82" y1="153" x2="96" y2="161"/>
        <line class="doom-tick" x1="153" y1="82" x2="161" y2="96"/>
      </g>
      <path class="doom-spiral" d="M250 250
        C252 244 260 244 264 250
        C270 260 261 273 248 273
        C228 273 218 252 225 235
        C236 209 272 204 294 222
        C325 247 316 296 283 316
        C239 343 180 317 166 269
        C148 208 196 151 258 151
        C334 151 385 220 366 291
        C342 379 246 415 171 373
        C80 322 69 196 140 121
        C224 32 379 61 443 166"/>
      <circle class="doom-trail-point" cx="443" cy="166" r="4.4"/>
      <g transform="rotate(60 250 250)"><line class="doom-hand minute" x1="250" y1="250" x2="250" y2="101"/></g>
      <g transform="rotate(125 250 250)"><line class="doom-hand hour" x1="250" y1="250" x2="250" y2="145"/></g>
      <circle class="doom-center-ring" cx="250" cy="250" r="11"/>
      <circle class="doom-center" cx="250" cy="250" r="4.5"/>
    </svg>
 </div>
 <div class="text"><img class="brain-logo" src="brain-davinci.svg" alt="Cerebro DoingLio"><div class="title">DoingLio</div><div class="sub">LABORATORIO DE SISTEMAS VIVOS</div><div class="spin" id="dots">ACTUALIZANDO PROYECTOS...</div></div>
</div>
</body>
</html>